{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@neoarc/graph-contracts": ["./src/neoarc-graph-contracts/index.ts"],
      "@neoarc/graph-contracts/*": ["./src/neoarc-graph-contracts/*"],
      "@neoarc/graph-core": ["./src/neoarc-graph-core/index.ts"],
      "@neoarc/graph-core/*": ["./src/neoarc-graph-core/*"],
      "@neoarc/graph-renderer": ["./src/neoarc-graph-renderer/index.ts"],
      "@neoarc/graph-renderer/*": ["./src/neoarc-graph-renderer/*"],
      "@neoarc/graph-cytoscape": ["./src/neoarc-graph-cytoscape/index.ts"],
      "@neoarc/graph-cytoscape/*": ["./src/neoarc-graph-cytoscape/*"],
      "@neoarc/graph-ui": ["./src/neoarc-graph-ui/index.ts"],
      "@neoarc/graph-ui/*": ["./src/neoarc-graph-ui/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
